# Keep only the five pinned original-page fixtures needed by the optional tests.
tools/svg-native/local-fixtures/*
!tools/svg-native/local-fixtures/assets/
tools/svg-native/local-fixtures/assets/*
!tools/svg-native/local-fixtures/assets/native-svg/
tools/svg-native/screenshots/
# The complete verified production SVG/JSON corpus is required for an offline build.
tools/mushaf-svg/local-assets/*
!tools/mushaf-svg/local-assets/mushaf-svg/

tools/ayah-highlight/screenshots/
tools/ayah-highlight/NativeSvgPageView.before.kt.txt

# Raw historical audit/build output is reproducible; retain manifests and summaries.
tools/**/*.stdout.txt
tools/**/*.stderr.txt
tools/**/*-stdout.txt
tools/**/*-stderr.txt
tools/svg-native/full-audit/upstream-report.json
tools/svg-native/full-audit/independent-report.json
tools/svg-native/clean-audit/upstream-full.json
tools/svg-native/clean-audit/upstream-subset.json
