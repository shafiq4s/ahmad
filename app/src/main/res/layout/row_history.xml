<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:padding="16dp" android:layoutDirection="rtl" android:orientation="vertical">
    <TextView android:id="@+id/history_surah" style="@style/SettingsHeading" android:textColor="@color/text_primary" android:textSize="20sp" />
    <TextView android:id="@+id/history_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary" android:textSize="15sp" />
    <TextView android:id="@+id/history_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textDirection="rtl" android:gravity="start" android:textColor="@color/text_secondary" android:textSize="13sp" />
</LinearLayout>
