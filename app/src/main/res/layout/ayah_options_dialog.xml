<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayah_dialog" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layoutDirection="rtl" android:padding="20dp"
    android:background="@drawable/ayah_dialog_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/ayah_dialog_surah" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="start" android:textDirection="rtl" android:textColor="@color/primary"
            android:textSize="22sp" android:textStyle="bold" />
        <Button android:id="@+id/ayah_dialog_close" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="48dp"
            android:text="@string/ayah_close" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingTop="4dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/ayah_dialog_number" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/ayah_dialog_juz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/ayah_dialog_page" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text_secondary" android:textSize="14sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/ayah_dialog_loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true"
        android:contentDescription="@string/ayah_loading" />
    <androidx.core.widget.NestedScrollView android:id="@+id/ayah_dialog_scroll" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_weight="1" android:clipToPadding="false">
        <TextView android:id="@+id/ayah_dialog_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp" android:paddingBottom="16dp" android:gravity="start" android:textDirection="rtl"
            android:fontFamily="serif" android:includeFontPadding="true" android:lineSpacingExtra="8dp"
            android:textColor="@color/text_primary" android:textSize="26sp" />
    </androidx.core.widget.NestedScrollView>
    <Button android:id="@+id/ayah_dialog_bookmark" style="@style/ReaderTextButton" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/bookmark_add_action" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingTop="8dp">
        <Button android:id="@+id/ayah_dialog_play" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:enabled="false" android:text="@string/ayah_play_later" android:textSize="14sp"
            android:textColor="@color/text_secondary" android:alpha="0.55" />
        <Button android:id="@+id/ayah_dialog_tafsir" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:enabled="false" android:text="@string/ayah_tafsir_later" android:textSize="14sp"
            android:textColor="@color/text_secondary" android:alpha="0.55" />
        <Button android:id="@+id/ayah_dialog_copy" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:enabled="false" android:text="@string/ayah_copy" android:textSize="16sp" />
        <Button android:id="@+id/ayah_dialog_share" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:enabled="false" android:text="@string/ayah_share" android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
