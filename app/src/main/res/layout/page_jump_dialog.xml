<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="rtl"
    android:orientation="vertical" android:padding="24dp" android:background="@drawable/ayah_dialog_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/page_jump_title"
        android:textSize="22sp" android:textStyle="bold" android:textColor="@color/primary" />
    <RadioGroup android:id="@+id/jump_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
        <RadioButton android:id="@+id/jump_mode_page" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/jump_page_mode" android:checked="true" />
        <RadioButton android:id="@+id/jump_mode_juz" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/jump_juz_mode" />
        <RadioButton android:id="@+id/jump_mode_surah" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/jump_surah_mode" />
    </RadioGroup>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/jump_hint" android:text="@string/page_jump_hint"
        android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" />
    <EditText android:id="@+id/page_number" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:layout_marginTop="16dp" android:inputType="number" android:importantForAutofill="no"
        android:imeOptions="actionGo" android:selectAllOnFocus="true" android:maxLines="1" android:maxLength="4"
        android:hint="@string/page_number" android:gravity="center" android:textSize="24sp" />
    <Spinner android:id="@+id/jump_selection" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:visibility="gone" android:contentDescription="@string/go_page" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="end" android:layout_marginTop="20dp">
        <Button android:id="@+id/jump_confirm" style="@style/ReaderTextButton" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="@string/go_page" />
        <Button android:id="@+id/jump_cancel" style="?android:attr/buttonBarButtonStyle" android:layout_width="wrap_content"
            android:layout_height="48dp" android:minWidth="64dp" android:layout_marginStart="8dp" android:text="@string/ayah_close" />
    </LinearLayout>
</LinearLayout>
