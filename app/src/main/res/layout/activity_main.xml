<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface">
<LinearLayout
    android:id="@+id/app_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:orientation="vertical" android:background="@color/surface">
    <FrameLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@color/surface">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/nav_quran" style="@style/ReaderIconButton"
                android:src="@drawable/ic_surahs" android:contentDescription="@string/surah_index" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/screen_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:text="@string/app_name" android:textSize="21sp" android:textStyle="bold"
                    android:textColor="@color/primary" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/reader_location" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/nav_settings" style="@style/ReaderIconButton"
                android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        </LinearLayout>
    </FrameLayout>
    <ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" android:contentDescription="@string/loading" />
    <TextView android:id="@+id/load_error" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:visibility="gone" android:text="@string/load_error" android:textSize="18sp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/retry_load" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:visibility="gone" android:text="@string/retry" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/home_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
                <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="24dp" android:src="@drawable/ic_launcher" android:importantForAccessibility="no" />
                <LinearLayout style="@style/SettingsSection">
                    <Button android:id="@+id/continue_reading" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/continue_reading" android:textStyle="bold" />
                    <TextView android:id="@+id/last_location" style="@style/SettingsBody" android:gravity="center" android:text="@string/last_read_empty" />
                </LinearLayout>
                <Button android:id="@+id/read_pages" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="56dp"
                    android:layout_marginTop="20dp" android:background="@drawable/primary_button_background" android:textColor="@color/surface" android:text="@string/open_mushaf" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                    <Button android:id="@+id/open_surahs" style="@style/ReaderTextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="@string/surah_index" />
                    <Button android:id="@+id/open_bookmarks" style="@style/ReaderTextButton" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/bookmarks_short" />
                </LinearLayout>
                <Button android:id="@+id/open_search" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="@string/search" />
                <Button android:id="@+id/open_history" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/reading_history" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/search_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <EditText android:id="@+id/quran_search_query" android:layout_width="match_parent" android:layout_height="56dp" android:hint="@string/quran_search_hint"
                    android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" android:importantForAutofill="no" android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="18sp" android:background="@drawable/settings_section_background" />
                <ProgressBar android:id="@+id/search_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" android:layout_marginTop="12dp" android:visibility="gone" />
                <TextView android:id="@+id/search_status" style="@style/SettingsBody" android:text="@string/quran_search_initial" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <ListView android:id="@+id/search_results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
            <Button android:id="@+id/search_more" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_margin="16dp" android:text="@string/quran_search_more" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/quran_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="16dp">
                <EditText android:id="@+id/surah_search" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:hint="@string/surah_search_hint" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" android:importantForAutofill="no"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="16sp" android:background="@drawable/settings_section_background" />
                <TextView android:id="@+id/surah_search_empty" style="@style/SettingsBody" android:text="@string/surah_search_empty" android:visibility="gone" />
            </LinearLayout>
            <ListView android:id="@+id/surah_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:fastScrollEnabled="true" android:divider="@color/divider" android:dividerHeight="1dp"
                android:paddingStart="4dp" android:paddingEnd="4dp" android:clipToPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/reader_panel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/selected_ayah" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:gravity="center" android:textSize="13sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <com.ahmad.quran.mushaf.svg.NativeSvgPageView android:id="@+id/mushaf_page" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:background="#FFFFFF" android:contentDescription="@string/mushaf_page_description" />
                <LinearLayout android:id="@+id/page_asset_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:layout_margin="24dp" android:background="@drawable/settings_section_background"
                    android:visibility="gone" android:accessibilityLiveRegion="polite">
                    <ProgressBar android:id="@+id/page_asset_progress" android:layout_width="32dp" android:layout_height="32dp" />
                    <TextView android:id="@+id/page_asset_message" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:gravity="center" android:textSize="16sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/page_asset_retry" style="@style/ReaderTextButton" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:layout_marginTop="16dp" android:text="@string/retry" android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/bottom_bar" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
                    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@color/surface">
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/previous_page" style="@style/ReaderIconButton"
                        android:src="@drawable/ic_chevron_right" android:contentDescription="@string/previous_page" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="horizontal" android:gravity="center">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
                            android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/page_number"
                                android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/page_indicator" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textSize="17sp" android:textStyle="bold" android:textColor="@color/primary" />
                        </LinearLayout>
                        <Button android:id="@+id/go_page" style="@style/ReaderTextButton" android:layout_width="wrap_content"
                            android:layout_height="48dp" android:minWidth="64dp" android:text="@string/go_page" android:textSize="14sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/toggle_bookmark" style="@style/ReaderIconButton"
                        android:src="@drawable/ic_bookmark" android:contentDescription="@string/bookmark_add_action" />
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/next_page" style="@style/ReaderIconButton"
                        android:src="@drawable/ic_chevron_left" android:contentDescription="@string/next_page" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/bookmarks_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:padding="20dp">
            <TextView style="@style/SettingsBody" android:text="@string/bookmarks_hint" android:layout_marginBottom="16dp" />
            <LinearLayout android:id="@+id/bookmarks_empty" style="@style/SettingsSection" android:gravity="center" android:layout_marginTop="24dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_bookmark" android:importantForAccessibility="no" />
                <TextView style="@style/SettingsHeading" android:text="@string/bookmarks_empty" android:gravity="center" android:layout_marginTop="16dp" />
                <TextView style="@style/SettingsBody" android:text="@string/bookmarks_empty_help" android:gravity="center" />
            </LinearLayout>
            <ListView android:id="@+id/bookmarks_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
        </LinearLayout>
        <ScrollView android:id="@+id/settings_panel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:id="@+id/settings_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout style="@style/SettingsSection">
                    <TextView style="@style/SettingsHeading" android:text="@string/reading_settings" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/dark_mode" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/dark_mode" android:textSize="16sp" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/keep_screen_awake" style="@style/ReadingSwitch" android:text="@string/keep_screen_awake" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/auto_resume_reading" style="@style/ReadingSwitch" android:text="@string/auto_resume_reading" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/show_reader_bars" style="@style/ReadingSwitch" android:text="@string/show_reader_bars" />
                    <TextView style="@style/SettingsBody" android:text="@string/svg_zoom_help" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsSection" android:layout_marginTop="16dp">
                    <TextView style="@style/SettingsHeading" android:text="@string/cache_heading" />
                    <TextView android:id="@+id/cache_size" style="@style/SettingsBody" />
                    <TextView android:id="@+id/cache_help" style="@style/SettingsBody" android:text="@string/cache_help" />
                    <Button android:id="@+id/cache_clear" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="@string/cache_clear" />
                    <TextView android:id="@+id/cache_feedback" style="@style/SettingsBody" android:visibility="gone" android:accessibilityLiveRegion="polite" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsSection" android:layout_marginTop="16dp">
                    <Button android:id="@+id/open_about" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about_heading" />
                    <Button android:id="@+id/open_support" style="@style/ReaderTextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/support_heading" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/history_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:padding="20dp">
            <TextView style="@style/SettingsBody" android:text="@string/history_hint" android:layout_marginBottom="16dp" />
            <LinearLayout android:id="@+id/history_empty" style="@style/SettingsSection" android:gravity="center" android:layout_marginTop="24dp">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_launcher" android:importantForAccessibility="no" />
                <TextView style="@style/SettingsHeading" android:text="@string/history_empty" android:gravity="center" android:layout_marginTop="16dp" />
                <TextView style="@style/SettingsBody" android:text="@string/history_empty_help" android:gravity="center" />
            </LinearLayout>
            <ListView android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp" />
        </LinearLayout>
        <ScrollView android:id="@+id/about_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout style="@style/SettingsSection" android:layout_marginTop="16dp">
                    <TextView style="@style/SettingsHeading" android:text="@string/about_heading" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="22sp" />
                    <TextView style="@style/SettingsBody" android:text="@string/about_description" />
                    <TextView android:id="@+id/app_version" style="@style/SettingsBody" />
                    <TextView style="@style/SettingsBody" android:text="@string/android_support" />
                    <TextView style="@style/SettingsBody" android:text="@string/about_sources" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsSection" android:layout_marginTop="16dp">
                    <TextView style="@style/SettingsHeading" android:text="@string/sources_heading" />
                    <TextView android:id="@+id/tanzil_attribution" style="@style/SettingsBody" android:autoLink="web" android:text="@string/tanzil_attribution" />
                    <TextView android:id="@+id/quran_svg_attribution" style="@style/SettingsBody" android:autoLink="web" android:text="@string/quran_svg_attribution" />
                    <TextView style="@style/SettingsBody" android:text="@string/tanzil_terms" />
                    <TextView style="@style/SettingsBody" android:text="@string/licenses_summary" />
                    <TextView style="@style/SettingsHeading" android:text="@string/privacy_heading" android:layout_marginTop="20dp" />
                    <TextView style="@style/SettingsBody" android:text="@string/privacy_placeholder" />
                    <Button android:id="@+id/show_license" style="@style/ReaderTextButton" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/show_license" />
                    <TextView android:id="@+id/license_notice" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:visibility="gone" android:textDirection="ltr" android:textSize="14sp" android:layout_marginTop="12dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/support_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:id="@+id/support_section" style="@style/SettingsSection" android:layout_marginTop="16dp">
                    <TextView style="@style/SettingsHeading" android:text="@string/support_heading" />
                    <TextView style="@style/SettingsBody" android:text="@string/support_description" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:padding="8dp" android:text="@string/coming_soon" android:textSize="14sp" android:textColor="@color/support_badge_text" android:background="@drawable/support_badge_background" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
    <LinearLayout android:id="@+id/launch_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@color/surface">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_launcher" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/app_name" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/primary" />
    </LinearLayout>
</FrameLayout>
